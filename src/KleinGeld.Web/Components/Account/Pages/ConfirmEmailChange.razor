@page "/Account/ConfirmEmailChange"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using KleinGeld.Data

@inject UserManager<Member> UserManager
@inject SignInManager<Member> SignInManager

@* Where the link in email 4 leads. *@

<PageTitle>Confirm email change</PageTitle>

<h1>Confirm email change</h1>

@if (_changed)
{
    <p role="status">Your login email is now <strong>@Email</strong>. <a href="">Go to KleinGeld Music</a>.</p>
}
else
{
    <p role="alert">
        This link has expired, was already used, or the address can't be used. Links work for 15 minutes.
        Your login email hasn't changed. To try again, go to <a href="Account/Manage/Email">Manage email</a>.
    </p>
}

@code {
    private bool _changed;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Email is null || Code is null)
        {
            return;
        }

        string code;
        try
        {
            code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        }
        catch (FormatException)
        {
            return;
        }

        var member = await UserManager.FindByIdAsync(UserId);
        if (member is null)
        {
            return;
        }

        // The email is the user name too. Set here so ChangeEmailAsync validates and saves both at once: a separate
        // SetUserNameAsync could fail after the email had already changed.
        member.UserName = Email;
        var result = await UserManager.ChangeEmailAsync(member, Email, code);
        if (result.Succeeded)
        {
            _changed = true;
            // Keeps this browser logged in despite the new security stamp, if it's the Member's own session.
            await SignInManager.RefreshSignInAsync(member);
        }
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["KleinGeld.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="RenderMode" />
</head>

<body>
    @* Shown until WebAssembly has loaded and the app shell renders; hidden by CSS in app.css. *@
    <div id="app-loading" role="status" aria-label="Loading KleinGeld Music">
        <div class="app-loading-logo">KleinGeld Music</div>
        <div class="app-loading-bar"><div class="app-loading-progress"></div></div>
        <div class="app-loading-text"></div>
    </div>
    <Routes @rendermode="RenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // No prerendering: a prerendered page would show buttons that don't work until WebAssembly loads.
    private static readonly IComponentRenderMode RenderMode = new InteractiveWebAssemblyRenderMode(prerender: false);
}

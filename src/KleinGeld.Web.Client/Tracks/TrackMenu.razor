@inject PlayerService Player
@inject HttpClient Http
@inject IPlaylistsState MyPlaylists

@* The menu of a Track row. It keeps its clicks to itself, because a click on the row plays the Track. *@

<span class="track-menu" @onclick:stopPropagation="true">
    <button type="button" aria-label="More for @Track.Title" aria-expanded="@(_open ? "true" : "false")"
            @onclick="ToggleAsync">⋯</button>
    @if (_open)
    {
        <span class="track-menu-items">
            <button type="button" @onclick="PlayNextAsync">Play next</button>
            <button type="button" @onclick="AddToQueueAsync">Add to queue</button>
            <span class="track-menu-heading">Add to Playlist</span>
            @if (_naming)
            {
                <form class="track-menu-new" @onsubmit="CreateAndAddAsync">
                    <input aria-label="New Playlist name" maxlength="@PlaylistForm.NameMaxLength" @bind="_newName" />
                    <button type="submit" disabled="@string.IsNullOrWhiteSpace(_newName)">Create</button>
                </form>
            }
            else
            {
                <button type="button" @onclick="() => _naming = true">New Playlist…</button>
            }
            @foreach (var playlist in MyPlaylists.Playlists)
            {
                <button type="button" @key="playlist.Id" @onclick="() => AddToPlaylistAsync(playlist)">@playlist.Name</button>
            }
        </span>
    }
    @if (_notice is not null)
    {
        <span class="track-menu-notice" role="status">@_notice</span>
    }
</span>

@code {
    private bool _open;
    private bool _naming;
    private string _newName = "";
    private string? _notice;

    [Parameter, EditorRequired]
    public PlayerTrack Track { get; set; } = null!;

    private async Task ToggleAsync()
    {
        _open = !_open;
        _naming = false;
        _newName = "";
        _notice = null;
        if (_open)
        {
            try
            {
                await MyPlaylists.LoadAsync();
            }
            catch (HttpRequestException)
            {
                // The menu shows the Playlists it already knew of.
            }
        }
    }

    private async Task PlayNextAsync()
    {
        _open = false;
        await Player.PlayNextAsync(Track);
    }

    private async Task AddToQueueAsync()
    {
        _open = false;
        await Player.AddToQueueAsync(Track);
    }

    private async Task AddToPlaylistAsync(PlaylistSummary playlist)
    {
        _open = false;
        try
        {
            using var response = await Http.PostAsJsonAsync($"api/playlists/{playlist.Id}/tracks", new AddToPlaylistForm { TrackId = Track.Id });
            _notice = response.IsSuccessStatusCode ? $"Added to {playlist.Name}"
                : response.StatusCode == HttpStatusCode.Conflict
                    ? await PlaylistRefusal.ReadAsync(response, $"Already on {playlist.Name}")
                    : "This Track couldn't be added.";
            if (response.IsSuccessStatusCode)
            {
                await MyPlaylists.LoadAsync();
            }
        }
        catch (HttpRequestException)
        {
            _notice = "Something went wrong. Try again.";
        }
    }

    private async Task CreateAndAddAsync()
    {
        var name = _newName.Trim();
        if (name.Length == 0)
        {
            return;
        }

        _open = false;
        _naming = false;
        _newName = "";
        try
        {
            using var response = await Http.PostAsJsonAsync("api/playlists", new PlaylistForm { Name = name });
            if (!response.IsSuccessStatusCode)
            {
                _notice = await PlaylistRefusal.ReadAsync(response, "The Playlist couldn't be made.");
                return;
            }

            var playlist = (await response.Content.ReadFromJsonAsync<PlaylistSummary>())!;
            await AddToPlaylistAsync(playlist);
        }
        catch (HttpRequestException)
        {
            _notice = "Something went wrong. Try again.";
        }
    }
}

@implements IDisposable
@inject PlayerService Player
@inject JsAudioElement Audio

@*
    The one audio element and its controls. MainLayout keeps this outside @Body and outside AuthorizeView, which can
    drop its content while it re-checks: either way the element would go, and the music with it.
*@

<audio @ref="_element" preload="metadata"></audio>

@if (Player.Current is not null || Player.Notice is not null)
{
    @* On a phone (app.css) this is the mini player until the Member opens it; the wider layout never needs to. *@
    <section class="player-bar @(Player.IsFullPlayerOpen ? "player-full" : null)" aria-label="Player">
        @if (Player.Notice is not null)
        {
            <p role="alert" class="player-notice">@Player.Notice</p>
        }
        @if (Player.Current is not null)
        {
            <button type="button" class="player-close" @onclick="Player.CloseFullPlayer">Close</button>
            <button type="button" class="player-step" @onclick="Player.PreviousAsync">Previous</button>
            <button type="button" @onclick="ToggleAsync">@(Player.IsPlaying ? "Pause" : "Play")</button>
            <button type="button" class="player-step" @onclick="Player.NextAsync">Next</button>
            <span class="player-title">@Player.Current.Title</span>
            <button type="button" class="player-open" aria-label="Open the full player"
                    @onclick="Player.OpenFullPlayer">@Player.Current.Title</button>
            <span class="player-time">@Format(_seekingTo ?? Player.Position)</span>
            <input type="range" class="player-seek" aria-label="Seek" min="0" step="1"
                   max="@((int)Player.Duration.TotalSeconds)"
                   value="@((int)(_seekingTo ?? Player.Position).TotalSeconds)"
                   @oninput="ShowSeeking" @onchange="SeekAsync" />
            <span class="player-time">@Format(Player.Duration)</span>
            <button type="button" class="player-step" aria-expanded="@(_queueOpen ? "true" : "false")"
                    @onclick="() => _queueOpen = !_queueOpen">Up next</button>
            @if (_queueOpen)
            {
                @* By index, not by id: the same Track can be in the Queue twice. *@
                <ol class="queue-panel" aria-label="Up next">
                    @for (var i = 0; i < Player.Queue.Count; i++)
                    {
                        var index = i;
                        var track = Player.Queue[index];
                        <li aria-current="@(index == Player.CurrentIndex ? "true" : null)">
                            <span class="queue-track">@track.Title · @track.Artist</span>
                            @if (index != Player.CurrentIndex)
                            {
                                <button type="button" aria-label="Remove @track.Title from the Queue"
                                        @onclick="() => Player.RemoveFromQueue(index)">Remove</button>
                            }
                        </li>
                    }
                </ol>
            }
        }
    </section>
}

@code {
    private ElementReference _element;

    // While the handle is dragged it follows the Member, not the audio.
    private TimeSpan? _seekingTo;

    private bool _queueOpen;

    protected override void OnInitialized() => Player.Changed += Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Audio.AttachAsync(_element);
        }
    }

    public void Dispose() => Player.Changed -= Refresh;

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private Task ToggleAsync() => Player.IsPlaying ? Player.PauseAsync() : Player.ResumeAsync();

    private void ShowSeeking(ChangeEventArgs e) => _seekingTo = Seconds(e);

    private async Task SeekAsync(ChangeEventArgs e)
    {
        await Player.SeekAsync(Seconds(e));
        _seekingTo = null;
    }

    private static TimeSpan Seconds(ChangeEventArgs e) =>
        TimeSpan.FromSeconds(double.Parse(e.Value!.ToString()!, System.Globalization.CultureInfo.InvariantCulture));

    private static string Format(TimeSpan time) => time.ToString(time.TotalHours >= 1 ? @"h\:mm\:ss" : @"m\:ss");
}

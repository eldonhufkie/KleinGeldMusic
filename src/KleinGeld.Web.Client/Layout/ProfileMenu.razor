<details class="profile-menu" open="@Open">
    <summary>@Email</summary>
    <a href="Account/Manage">Settings</a>
    <form action="Account/Logout" method="post">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="" />
        <button type="submit">Log out</button>
    </form>
</details>

@code {
    /// <summary>Starts unfolded, for where the menu already sits behind a tap of its own.</summary>
    [Parameter]
    public bool Open { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string? Email { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Email = (await AuthenticationState).User.Identity?.Name;
    }
}

@implements IDisposable
@inject IManagedArtistsState ManagedArtists
@inject IReviewCountState ReviewCount

<nav class="sidebar" aria-label="Main">
    <div class="sidebar-logo">KleinGeld Music</div>
    <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
    @if (ManagedArtists.ManagesArtist)
    {
        <NavLink href="my-artists">My Artists</NavLink>
    }
    <AuthorizeView Roles="@Roles.Admin">
        <NavLink href="admin">
            Admin
            @if (ReviewCount.Count > 0)
            {
                <span class="review-badge" aria-label="Waiting for review">@ReviewCount.Count</span>
            }
        </NavLink>
    </AuthorizeView>
</nav>

@code {
    protected override async Task OnInitializedAsync()
    {
        ManagedArtists.Changed += OnChanged;
        ReviewCount.Changed += OnChanged;
        try
        {
            await ManagedArtists.LoadAsync();
            await ReviewCount.LoadAsync();
        }
        catch (HttpRequestException)
        {
            // The sidebar simply goes without My Artists or the badge until the next load.
        }
    }

    private void OnChanged() => StateHasChanged();

    public void Dispose()
    {
        ManagedArtists.Changed -= OnChanged;
        ReviewCount.Changed -= OnChanged;
    }
}

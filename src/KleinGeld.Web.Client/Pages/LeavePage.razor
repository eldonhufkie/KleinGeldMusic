@page "/leave"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AntiforgeryStateProvider Antiforgery

@* Leaving KleinGeld Music for good: what goes, then the password or a passkey again. *@

<PageTitle>Leave · KleinGeld Music</PageTitle>

<h1>Leave KleinGeld Music</h1>

@if (_preview is null)
{
    <p>@(_failed ? "Something went wrong. Reload the page and try again." : "Loading…")</p>
}
else
{
    <p>Leaving KleinGeld Music is for good. This also deletes:</p>
    <DeletionPreviewList Preview="_preview" Own="true" />

    <EditForm Model="_form" OnSubmit="LeaveAsync" class="leave-form">
        <label for="leave-password">Your password</label>
        <InputText id="leave-password" type="password" autocomplete="current-password" @bind-Value="_form.Password" />
        @if (_refused is not null)
        {
            <p class="validation-message" role="alert">@_refused</p>
        }
        <button type="submit" disabled="@_leaving">@(_leaving ? "Leaving…" : "Leave for good")</button>
        <button type="button" disabled="@_leaving" @onclick="LeaveWithPasskeyAsync">Leave for good with a passkey</button>
    </EditForm>
}

@code {
    private readonly LeaveForm _form = new();
    private DeletionPreview? _preview;
    private bool _failed;
    private bool _leaving;
    private string? _refused;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _preview = await Http.GetFromJsonAsync<DeletionPreview>("api/me/leave");
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
    }

    private Task LeaveAsync() => SendAsync(new LeaveForm { Password = _form.Password });

    private async Task LeaveWithPasskeyAsync()
    {
        _leaving = true;
        _refused = null;
        string credentialJson;
        try
        {
            // The same passkey request the login page makes, from the Identity pages' script.
            await using var passkeys = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Account/Shared/PasskeySubmit.razor.js");
            var token = Antiforgery.GetAntiforgeryToken();
            credentialJson = await passkeys.InvokeAsync<string>("requestCredentialJson", "RequestVerificationToken", token?.Value ?? "");
        }
        catch (JSException)
        {
            _refused = "No passkey was provided.";
            _leaving = false;
            return;
        }
        await SendAsync(new LeaveForm { PasskeyCredentialJson = credentialJson });
    }

    private async Task SendAsync(LeaveForm form)
    {
        _leaving = true;
        _refused = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/me/leave", form);
            if (response.IsSuccessStatusCode)
            {
                // The next person on this device mustn't find the player as it was.
                await JS.InvokeVoidAsync("localStorage.removeItem", JsPlayerStorage.Key);
                Navigation.NavigateTo("", forceLoad: true);
                return;
            }

            _refused = response.StatusCode switch
            {
                HttpStatusCode.BadRequest => "That password or passkey isn't right.",
                HttpStatusCode.Conflict => "The Admin can't Leave.",
                _ => "Something went wrong. Try again.",
            };
        }
        catch (HttpRequestException)
        {
            _refused = "Something went wrong. Try again.";
        }
        finally
        {
            _leaving = false;
        }
    }
}

@page "/admin/awaiting-password"
@attribute [Authorize(Roles = Roles.Admin)]
@inject HttpClient Http

@* Approved Members who haven't set a password yet. Resend sends email 1 again; the link only ever goes to their inbox. *@

<PageTitle>Waiting to set a password · KleinGeld Music</PageTitle>

<h1>Waiting to set a password</h1>

@if (_failed)
{
    <p role="alert">Something went wrong. Reload the page and try again.</p>
}

@if (_waiting is null)
{
    <p>Loading…</p>
}
else if (_waiting.Count == 0)
{
    <p>Every Member has set a password.</p>
}
else
{
    <ul class="join-requests">
        @foreach (var member in _waiting)
        {
            <li class="join-request">
                <p><strong>@member.Email</strong></p>
                <div class="actions">
                    @if (_resent.Contains(member.Id))
                    {
                        <span role="status">Sent</span>
                    }
                    <button type="button" class="btn btn-primary" disabled="@(_resending is not null)" @onclick="() => ResendAsync(member)">
                        @(_resending == member.Id ? "Sending…" : "Resend setup email")
                    </button>
                </div>
            </li>
        }
    </ul>
}

@code {
    private List<MemberAwaitingPassword>? _waiting;
    private readonly HashSet<Guid> _resent = [];

    /// <summary>The Member whose email is on its way, which disables every button.</summary>
    private Guid? _resending;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _waiting = await Http.GetFromJsonAsync<List<MemberAwaitingPassword>>("api/admin/members/awaiting-password");
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
    }

    private async Task ResendAsync(MemberAwaitingPassword member)
    {
        _resending = member.Id;
        _failed = false;
        try
        {
            using var response = await Http.PostAsync($"api/admin/members/{member.Id}/resend-setup-email", null);
            if (response.IsSuccessStatusCode)
            {
                _resent.Add(member.Id);
            }
            else
            {
                _failed = true;
            }
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
        finally
        {
            _resending = null;
        }
    }
}

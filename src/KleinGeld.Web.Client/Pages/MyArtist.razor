@page "/my-artists/{Id:guid}/{Slug?}"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IManagedArtistsState ManagedArtists

@* One Artist in My Artists: its Releases and managers. The API redirects an old slug; the address follows here. *@

<PageTitle>@(_artist?.Name ?? "My Artists") · KleinGeld Music</PageTitle>

@if (_failed)
{
    <p role="alert">Something went wrong. Reload the page and try again.</p>
}

@if (_artist is null)
{
    <p>@(_failed ? "" : "Loading…")</p>
}
else
{
    <h1>@_artist.Name</h1>

    <h2>Releases</h2>
    <p><a href="my-artists/@_artist.Id/new-release">New Release</a></p>
    @if (_artist.Releases.Count == 0)
    {
        <p>No Releases yet.</p>
    }
    else
    {
        <ul class="artists">
            @foreach (var release in _artist.Releases)
            {
                <li>
                    <a href="my-releases/@release.Id/@release.Slug">@release.Title</a>
                    <span class="stage-badge">@release.Stage</span>
                </li>
            }
        </ul>
    }

    <h2>Managers</h2>
    <ul class="artists">
        @foreach (var manager in _artist.Managers)
        {
            <li>
                @manager.Name
                <button type="button" disabled="@_changingManagers" @onclick="() => StopManagingAsync(manager)">Stop managing</button>
            </li>
        }
    </ul>
    @if (_refusal is not null)
    {
        <p role="alert">@_refusal</p>
    }

    <form class="artist-form" @onsubmit="AddManagerAsync">
        <label for="new-manager">Add a manager</label>
        <select id="new-manager" @bind="_pickedMemberId">
            <option value="">Pick a Member…</option>
            @foreach (var candidate in _candidates)
            {
                <option value="@candidate.Id">@candidate.Name</option>
            }
        </select>
        <button type="submit" disabled="@(_changingManagers || _pickedMemberId is null)">Add manager</button>
    </form>

    <h2>Rename</h2>
    <EditForm Model="_form" OnValidSubmit="RenameAsync" class="artist-form">
        <DataAnnotationsValidator />

        <label for="artist-name">Name</label>
        <InputText id="artist-name" @bind-Value="_form.Name" maxlength="@ArtistForm.NameMaxLength" />
        <ValidationMessage For="() => _form.Name" />

        <button type="submit" disabled="@_renaming">@(_renaming ? "Saving…" : "Save name")</button>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public string? Slug { get; set; }

    private readonly ArtistForm _form = new();
    private ManagedArtist? _artist;
    private IReadOnlyList<ArtistManager> _candidates = [];
    private Guid? _pickedMemberId;
    private bool _changingManagers;
    private string? _refusal;
    private bool _renaming;
    private bool _failed;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _artist = await Http.GetFromJsonAsync<ManagedArtist>($"api/my-artists/{Id}/{Slug}");
            _candidates = (await Http.GetFromJsonAsync<List<ArtistManager>>($"api/artists/{Id}/managers/candidates"))!;
            _form.Name = _artist!.Name;
            if (_artist.Slug != Slug)
            {
                Navigation.NavigateTo($"my-artists/{Id}/{_artist.Slug}", replace: true);
            }
        }
        catch (HttpRequestException e) when (e.StatusCode == HttpStatusCode.NotFound)
        {
            Navigation.NotFound();
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
    }

    private async Task AddManagerAsync()
    {
        var form = new AddManagerForm { MemberId = _pickedMemberId!.Value };
        await ChangeManagersAsync(async () =>
        {
            using var response = await Http.PostAsJsonAsync($"api/artists/{Id}/managers", form);
            _failed = !response.IsSuccessStatusCode;
            if (response.IsSuccessStatusCode)
            {
                _pickedMemberId = null;
                await LoadAsync();
            }
        });
    }

    private Task StopManagingAsync(ArtistManager manager) => ChangeManagersAsync(async () =>
    {
        using var response = await Http.DeleteAsync($"api/artists/{Id}/managers/{manager.Id}");
        if (response.StatusCode == HttpStatusCode.Conflict)
        {
            _refusal = (await response.Content.ReadFromJsonAsync<Refusal>())?.Detail;
        }
        else if (response.IsSuccessStatusCode)
        {
            // Stopping themselves takes this page away from the Member, and perhaps My Artists too.
            await ManagedArtists.LoadAsync();
            var managed = await Http.GetFromJsonAsync<List<ArtistSummary>>("api/my-artists");
            if (managed!.Any(a => a.Id == Id))
            {
                await LoadAsync();
            }
            else
            {
                Navigation.NavigateTo("my-artists");
            }
        }
        else
        {
            _failed = true;
        }
    });

    private async Task ChangeManagersAsync(Func<Task> change)
    {
        _changingManagers = true;
        _failed = false;
        _refusal = null;
        try
        {
            await change();
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
        finally
        {
            _changingManagers = false;
        }
    }

    private sealed record Refusal(string? Detail);

    private async Task RenameAsync()
    {
        _renaming = true;
        _failed = false;
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/artists/{Id}", _form);
            _failed = !response.IsSuccessStatusCode;
            if (response.IsSuccessStatusCode)
            {
                await LoadAsync();
            }
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
        finally
        {
            _renaming = false;
        }
    }
}

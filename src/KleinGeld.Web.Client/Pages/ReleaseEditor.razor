@page "/my-artists/{ArtistId:guid}/new-release"
@page "/my-releases/{Id:guid}/{Slug?}"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation

@* Starts a New Release, or edits an existing one. The API redirects an old slug; the address follows here. *@

<PageTitle>@Heading · KleinGeld Music</PageTitle>

@if (_failed)
{
    <p role="alert">Something went wrong. Reload the page and try again.</p>
}

@if (Id is not null && _release is null)
{
    <p>@(_failed ? "" : "Loading…")</p>
}
else
{
    <h1>@Heading</h1>
    @if (_release is not null)
    {
        <p>
            <a href="my-artists/@_release.ArtistId">@_release.ArtistName</a>
            <span class="stage-badge">@_release.Stage</span>
        </p>
    }

    @* A disabled fieldset turns off everything inside it, so the lock needs no check per control. *@
    <fieldset class="release-fields" disabled="@Locked">
    <EditForm Model="_form" OnValidSubmit="SaveAsync" class="artist-form">
        <DataAnnotationsValidator />

        <label for="release-title">Title</label>
        <InputText id="release-title" @bind-Value="_form.Title" maxlength="@ReleaseForm.TitleMaxLength" />
        <ValidationMessage For="() => _form.Title" />

        <label for="release-type">Release type</label>
        <InputSelect id="release-type" @bind-Value="_form.Type">
            <option value="">Choose…</option>
            @foreach (var type in Enum.GetValues<ReleaseType>())
            {
                <option value="@type">@type</option>
            }
        </InputSelect>
        <ValidationMessage For="() => _form.Type" />

        <label for="release-date">Release date</label>
        <InputDate id="release-date" @bind-Value="_form.ReleaseDate" />
        <ValidationMessage For="() => _form.ReleaseDate" />

        <label for="release-description">Description (optional)</label>
        <InputTextArea id="release-description" @bind-Value="_form.Description" maxlength="@ReleaseForm.DescriptionMaxLength" rows="6" />
        <ValidationMessage For="() => _form.Description" />

        <label for="release-genre">Genre (optional)</label>
        <InputText id="release-genre" @bind-Value="_form.Genre" maxlength="@ReleaseForm.GenreMaxLength" />
        <ValidationMessage For="() => _form.Genre" />

        <button type="submit" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
    </EditForm>

    @if (_release is not null)
    {
        <CoverUpload Release="_release" OnUploaded="TakeInCover" />

        <ReleaseTracks ReleaseId="_release.Id" OnConfirmed="TakeInPreFilledAsync" OnStatusesChanged="TakeInStatuses" />
    }
    </fieldset>

    @if (_release is not null)
    {
        <p><a href="releases/@_release.Id/@_release.Slug">Open the Release page</a></p>

        @if (_release.Stage is ReleaseStage.Draft or ReleaseStage.Rejected)
        {
            <h2>Submit</h2>
            <label><input type="checkbox" @bind="_rightsDeclared" /> @RightsDeclarationWording.Text</label>
            @if (SubmitRefusal is not null)
            {
                <p>@SubmitRefusal</p>
            }
            <button type="button" disabled="@(_busy || SubmitRefusal is not null || !_rightsDeclared)" @onclick="SubmitAsync">Submit for review</button>
        }
        else if (Locked)
        {
            <h2>Submitted</h2>
            <p>This Release is waiting for the Admin's review and can't be changed. Withdraw it to edit it again.</p>
            <button type="button" disabled="@_busy" @onclick="WithdrawAsync">Withdraw</button>
        }

        @if (_problem is not null)
        {
            <p role="alert">@_problem</p>
        }
    }

    @if (_release is not null && !Locked)
    {
        <h2>Delete</h2>
        @if (_confirmingDelete)
        {
            <p>Delete this Release for good?</p>
            <button type="button" disabled="@_busy" @onclick="DeleteAsync">Yes, delete it</button>
            <button type="button" disabled="@_busy" @onclick="() => _confirmingDelete = false">Keep it</button>
        }
        else
        {
            <button type="button" @onclick="() => _confirmingDelete = true">Delete Release</button>
        }
    }
}

@code {
    [Parameter]
    public Guid? ArtistId { get; set; }

    [Parameter]
    public Guid? Id { get; set; }

    [Parameter]
    public string? Slug { get; set; }

    private readonly ReleaseForm _form = new();
    private ReleaseDetails? _release;
    private bool _confirmingDelete;
    private bool _busy;
    private bool _failed;

    private bool _rightsDeclared;
    private string? _problem;
    private IReadOnlyCollection<TrackStatus> _statuses = [];

    private string Heading => string.IsNullOrEmpty(_release?.Title) ? "New Release" : _release.Title;

    private bool Locked => _release?.Stage == ReleaseStage.Submitted;

    /// <summary>Goes by the form, not the saved Release: Submit saves what's typed first.</summary>
    private string? SubmitRefusal => SubmitRules.Refusal(_form.Title, _form.ReleaseDate, _release?.Cover is not null, _statuses);

    private void TakeInCover(CoverArt? cover) => _release = _release! with { Cover = cover };

    private void TakeInStatuses(IReadOnlyCollection<TrackStatus> statuses) => _statuses = statuses;

    private sealed record Refusal(string? Detail);

    private async Task SubmitAsync()
    {
        await ChangeStageAsync(async () =>
        {
            var saved = await Http.PutAsJsonAsync($"api/releases/{Id}", _form);
            return saved.IsSuccessStatusCode
                ? await Http.PostAsJsonAsync($"api/releases/{Id}/submit", new SubmitForm { RightsDeclared = _rightsDeclared })
                : saved;
        });
        _rightsDeclared = false;
    }

    private Task WithdrawAsync() => ChangeStageAsync(() => Http.PostAsync($"api/releases/{Id}/withdraw", null));

    private async Task ChangeStageAsync(Func<Task<HttpResponseMessage>> send)
    {
        _busy = true;
        _problem = null;
        try
        {
            using var response = await send();
            if (response.IsSuccessStatusCode)
            {
                Show(await response.Content.ReadFromJsonAsync<ReleaseDetails>());
            }
            else
            {
                _problem = (await response.Content.ReadFromJsonAsync<Refusal>())?.Detail ?? "Something went wrong. Reload the page and try again.";
            }
        }
        catch (HttpRequestException)
        {
            _problem = "Something went wrong. Reload the page and try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // The address changing to a new slug isn't a new Release, and reloading would lose what's being typed.
        if (Id is null || _release?.Id == Id)
        {
            return;
        }

        try
        {
            Show(await Http.GetFromJsonAsync<ReleaseDetails>($"api/releases/{Id}/{Slug}"));
        }
        catch (HttpRequestException e) when (e.StatusCode == HttpStatusCode.NotFound)
        {
            Navigation.NotFound();
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
    }

    private void Show(ReleaseDetails? release)
    {
        _release = release!;
        _form.Title = _release.Title;
        _form.Type = _release.Type;
        _form.ReleaseDate = _release.ReleaseDate;
        _form.Description = _release.Description;
        _form.Genre = _release.Genre;
        if (_release.Slug != Slug)
        {
            Navigation.NavigateTo($"my-releases/{_release.Id}/{_release.Slug}", replace: true);
        }
    }

    /// <summary>Shows what an audio file's tags filled, in the form's blank fields only: the rest may be unsaved typing.</summary>
    private async Task TakeInPreFilledAsync()
    {
        var latest = await Http.GetFromJsonAsync<ReleaseDetails>($"api/releases/{_release!.Id}/{_release.Slug}");
        _release = latest!;
        if (string.IsNullOrWhiteSpace(_form.Title))
        {
            _form.Title = _release.Title;
        }
        _form.ReleaseDate ??= _release.ReleaseDate;
        if (string.IsNullOrWhiteSpace(_form.Genre))
        {
            _form.Genre = _release.Genre;
        }
        if (_release.Slug != Slug)
        {
            Navigation.NavigateTo($"my-releases/{_release.Id}/{_release.Slug}", replace: true);
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _failed = false;
        try
        {
            using var response = Id is null
                ? await Http.PostAsJsonAsync($"api/artists/{ArtistId}/releases", _form)
                : await Http.PutAsJsonAsync($"api/releases/{Id}", _form);
            _failed = !response.IsSuccessStatusCode;
            if (response.IsSuccessStatusCode)
            {
                Show(await response.Content.ReadFromJsonAsync<ReleaseDetails>());
            }
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        _failed = false;
        try
        {
            using var response = await Http.DeleteAsync($"api/releases/{Id}");
            _failed = !response.IsSuccessStatusCode;
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo($"my-artists/{_release!.ArtistId}");
            }
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
        finally
        {
            _busy = false;
        }
    }
}

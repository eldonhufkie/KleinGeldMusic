@page "/artists/{Id:guid}/{Slug?}"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PlayerService Player

@* The public Artist page: a listener's view for everyone, managers too. They manage it from My Artists. *@

<PageTitle>@(_artist?.Name ?? "Artist") · KleinGeld Music</PageTitle>

@if (_failed)
{
    <p role="alert">Something went wrong. Reload the page and try again.</p>
}
else if (_artist is null)
{
    <p>Loading…</p>
}
else
{
    <h1>@_artist.Name</h1>

    @if (_artist.Newest is not null)
    {
        <p><button type="button" aria-label="Play @_artist.Newest.Title" @onclick="PlayNewestAsync">Play</button></p>
    }
    @if (_problem is not null)
    {
        <p role="alert">@_problem</p>
    }

    @Section("Albums", _artist.Albums)
    @Section("EPs", _artist.EPs)
    @Section("Singles", _artist.Singles)
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public string? Slug { get; set; }

    private ArtistDetails? _artist;
    private bool _failed;
    private string? _problem;

    private RenderFragment Section(string title, IReadOnlyList<ArtistRelease> releases) =>
        @<text>
            @if (releases.Count > 0)
            {
                <h2>@title</h2>
                <ul class="card-grid">
                    @foreach (var release in releases)
                    {
                        <li @key="release.Id">
                            <a href="releases/@release.Id/@release.Slug">
                                @if (release.Cover is not null)
                                {
                                    <img class="cover-art" src="@release.Cover.Small" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="cover-missing"></span>
                                }
                                <span>@release.Title</span>
                                <span class="card-detail">@release.ReleaseDate?.Year</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </text>;

    private async Task PlayNewestAsync()
    {
        _problem = null;
        try
        {
            var tracks = await Http.GetFromJsonAsync<List<TrackSummary>>($"api/tracks?releaseId={_artist!.Newest!.Id}");
            var release = tracks!
                .Select(t => new PlayerTrack(t.Id, t.Title, _artist.Name, t.Status == TrackStatus.Ready))
                .ToList();
            var first = release.FindIndex(t => t.IsAvailable);
            if (first >= 0)
            {
                await Player.PlayAsync(release, first);
            }
        }
        catch (HttpRequestException)
        {
            _problem = "Something went wrong. Try again.";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _artist = await Http.GetFromJsonAsync<ArtistDetails>($"api/artists/{Id}/{Slug}");
            if (_artist!.Slug != Slug)
            {
                Navigation.NavigateTo($"artists/{Id}/{_artist.Slug}", replace: true);
            }
        }
        catch (HttpRequestException e) when (e.StatusCode == HttpStatusCode.NotFound)
        {
            Navigation.NotFound();
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
    }
}

@inject HttpClient Http
@inject IJSRuntime JS

@* The Track list of a Draft: adds audio files, straight to blob storage, with each upload's progress. *@

<h2>Tracks</h2>

@foreach (var message in _messages)
{
    <p role="alert">@message</p>
}

@if (_tracks.Count > 0)
{
    <ol>
        @foreach (var track in _tracks)
        {
            <li>
                @track.Title
                <span class="stage-badge">@track.Status</span>
                @if (_progress.TryGetValue(track.Id, out var percent))
                {
                    <progress max="100" value="@percent" aria-label="Upload of @track.Title">@percent%</progress>
                }
                <button type="button" disabled="@_busy" @onclick="() => RemoveAsync(track)">Remove</button>
            </li>
        }
    </ol>
}

<label for="track-files">Add audio files</label>
<input id="track-files" type="file" multiple accept="audio/*,.flac,.aiff,.aif,.m4a" disabled="@_busy" @ref="_input" @onchange="UploadChosenAsync" />

@code {
    [Parameter, EditorRequired]
    public Guid ReleaseId { get; set; }

    /// <summary>A file was accepted, so its tags may have filled details of the Release.</summary>
    [Parameter]
    public EventCallback OnConfirmed { get; set; }

    private sealed record Problem(string? Detail);

    private readonly Dictionary<Guid, int> _progress = [];
    private readonly List<string> _messages = [];
    private List<TrackSummary> _tracks = [];
    private ElementReference _input;
    private bool _busy;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _tracks = await Http.GetFromJsonAsync<List<TrackSummary>>($"api/tracks?releaseId={ReleaseId}") ?? [];
        }
        catch (HttpRequestException)
        {
            _messages.Add("The Tracks couldn't be loaded. Reload the page and try again.");
        }
    }

    private async Task UploadChosenAsync()
    {
        _busy = true;
        _messages.Clear();
        try
        {
            var files = await BlobUpload.ChosenFilesAsync(JS, _input);
            for (var index = 0; index < files.Count; index++)
            {
                await UploadAsync(index, files[index]);
            }
            await BlobUpload.ClearAsync(JS, _input);
        }
        catch (HttpRequestException)
        {
            _messages.Add("Something went wrong. Reload the page and try again.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UploadAsync(int index, BlobUpload.ChosenFile file)
    {
        using var requested = await Http.PostAsJsonAsync(
            $"api/releases/{ReleaseId}/tracks", new TrackUploadForm { FileName = file.Name, Size = file.Size });
        if (!requested.IsSuccessStatusCode)
        {
            await ReportAsync(file, requested);
            return;
        }

        var upload = (await requested.Content.ReadFromJsonAsync<TrackUpload>())!;
        _tracks.Add(upload.Track);
        _progress[upload.Track.Id] = 0;
        StateHasChanged();

        var uploaded = await BlobUpload.SendAsync(JS, _input, upload.UploadLink, percent =>
        {
            _progress[upload.Track.Id] = percent;
            StateHasChanged();
        }, index);
        _progress.Remove(upload.Track.Id);

        if (uploaded)
        {
            using var confirmed = await Http.PostAsync($"api/releases/{ReleaseId}/tracks/{upload.Track.Id}/confirm", null);
            if (!confirmed.IsSuccessStatusCode)
            {
                await ReportAsync(file, confirmed);
            }
            else
            {
                var confirmation = await confirmed.Content.ReadFromJsonAsync<TrackConfirmation>();
                if (confirmation?.Note is { } note)
                {
                    _messages.Add($"{file.Name}: {note}");
                }
                await OnConfirmed.InvokeAsync();
            }
        }
        else
        {
            _messages.Add($"{file.Name}: the upload failed. Try adding it again.");
            using var _ = await Http.DeleteAsync($"api/releases/{ReleaseId}/tracks/{upload.Track.Id}");
        }
        await LoadAsync();
    }

    private async Task ReportAsync(BlobUpload.ChosenFile file, HttpResponseMessage response)
    {
        var problem = response.StatusCode is HttpStatusCode.Conflict or HttpStatusCode.UnprocessableEntity
            ? await response.Content.ReadFromJsonAsync<Problem>()
            : null;
        _messages.Add($"{file.Name}: {problem?.Detail ?? "it couldn't be added. A file can be at most 500 MB."}");
    }

    private async Task RemoveAsync(TrackSummary track)
    {
        _busy = true;
        _messages.Clear();
        try
        {
            using var _ = await Http.DeleteAsync($"api/releases/{ReleaseId}/tracks/{track.Id}");
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _messages.Add("Something went wrong. Reload the page and try again.");
        }
        finally
        {
            _busy = false;
        }
    }

}

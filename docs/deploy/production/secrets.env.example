# Production secrets: copy to /mnt/<pool>/kleingeld/production/secrets.env, chmod 600, fill in.
# The names match what the generated docker-compose.yaml reads; keep a copy in the password manager.
ADMIN_EMAIL=
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# Azure audio account connection string (needs the account key: the app manages the stored access policy).
BLOBS=
# Gmail: Endpoint=smtp://smtp.gmail.com:587;Username=<address>;Password=<app password>
SMTP=
EMAIL_FROM=KleinGeld Music <address@gmail.com>

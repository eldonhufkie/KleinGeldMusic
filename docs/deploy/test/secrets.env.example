# Test secrets: copy to /mnt/<pool>/kleingeld/test/secrets.env, chmod 600, fill in.
# The names match what the generated docker-compose.yaml reads. Blobs go to Azurite and email to MailPit.
ADMIN_EMAIL=
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# The site's address on the tailnet (tailscale serve in front of 127.0.0.1:8081), e.g. https://kleingeld-test.<tailnet>.ts.net
SITE_ORIGIN=
# Where browsers reach Azurite (tailscale serve in front of 127.0.0.1:10000), e.g. https://kleingeld-test.<tailnet>.ts.net:10000/devstoreaccount1
BLOBS_PUBLIC_ENDPOINT=
